# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI (Gemini) — reads PDFs in the data pipeline; engine fallback
GEMINI_API_KEY=

# Groq (free, fast Llama) — preferred for the engine + AI tutor when set
GROQ_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (zero-fee UPI flow) — optional until you launch paid plans
NEXT_PUBLIC_UPI_VPA=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Transactional email — see project_reference/EMAIL_SETUP.md
# Use the SAME account for Supabase Auth's custom SMTP so login + activation
# mail both come from cramBIT, not "Supabase".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="cramBIT <you@gmail.com>"
RESEND_API_KEY=
