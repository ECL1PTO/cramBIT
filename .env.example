# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI (Gemini) — reads PDFs in the data pipeline; engine fallback
GEMINI_API_KEY=

# LLM providers for the engine + tutor. Each free tier has a small daily budget;
# set as many as you can and cramBIT chains across them. For real traffic add a
# $10 one-time OpenRouter credit (→ 1000 req/day) or Gemini API billing.
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Optional: an OpenAI-compatible gateway (OmniRoute, LiteLLM, …). If set, the
# engine routes everything here instead of the built-in free-provider chain.
# For OmniRoute: URL is the dashboard endpoint + no trailing slash (note /api/v1),
# MODEL is the name of the combo you created (Priority strategy, quota-aware
# fallback across every provider you added).
#   LLM_GATEWAY_URL=https://<dashed-ip>.sslip.io/api/v1
#   LLM_GATEWAY_MODEL=crambit
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
LLM_GATEWAY_MODEL=auto
LLM_GATEWAY_MODEL_FAST=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments — Razorpay (preferred: auto-unlock on payment.captured webhook).
# Individual/unregistered account is fine. Set the webhook in the Razorpay
# dashboard: URL https://<site>/api/payments/razorpay, event payment.captured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=   # same as RAZORPAY_KEY_ID — exposed to checkout

# Payments — manual zero-fee UPI flow (fallback / used when Razorpay is unset)
NEXT_PUBLIC_UPI_VPA=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Transactional email — see project_reference/EMAIL_SETUP.md
# Use the SAME account for Supabase Auth's custom SMTP so login + activation
# mail both come from cramBIT, not "Supabase".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="cramBIT <you@gmail.com>"
RESEND_API_KEY=
